{
  "name": "wispra",
  "version": "0.6.6",
  "description": "System-wide voice dictation: speak anywhere, get text typed into any app.",
  "main": "out/main/index.js",
  "author": "SinhGiang",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:daily-limit": "electron-vite build && electron scripts/check-daily-limit.cjs",
    "check:ai-fallback": "electron-vite build && electron scripts/check-ai-fallback.cjs",
    "check:transcript-columns": "electron-vite build && electron scripts/check-transcript-columns.cjs",
    "check:live-transcript": "electron-vite build && electron scripts/check-live-transcript.cjs",
    "check:cloud-long-dictation": "electron-vite build && electron scripts/check-cloud-long-dictation.cjs",
    "check:account-plan": "electron-vite build && electron scripts/check-account-plan.cjs",
    "check:mind-map-background": "electron-vite build && electron scripts/check-mind-map-background.cjs",
    "check:cloud-switch": "electron-vite build && electron scripts/check-cloud-switch.cjs",
    "check:auto-ai-new-only": "electron-vite build && electron scripts/check-auto-ai-new-only.cjs",
    "check:content-retry": "electron-vite build && electron scripts/check-content-retry.cjs",
    "check:ai-quota": "electron-vite build && electron scripts/check-ai-quota.cjs",
    "check:content-rate-limit": "electron-vite build && electron scripts/check-content-rate-limit.cjs",
    "postinstall": "node scripts/generate-icons.js",
    "build:win": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
